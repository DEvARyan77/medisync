PORT=5000
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medisync
# Any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend URL allowed by CORS (Vercel URL in production)
CLIENT_URL=http://localhost:5173
# Create demo users (password123) on startup
SEED_DEMO=true
# Email via Brevo's HTTP API (Render's free plan blocks SMTP). Leave empty to only log emails.
BREVO_API_KEY=
# Sender address verified in Brevo (Senders, domains & dedicated IPs > Senders)
EMAIL_FROM=
EMAIL_FROM_NAME=MediSync
# Clinic time zone for dates and slots
CLINIC_TZ=Asia/Kolkata
# Sign in with Google: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Add your frontend URL under "Authorized JavaScript origins". Empty = no Google button.
GOOGLE_CLIENT_ID=
# Sign in with Facebook: developers.facebook.com > My Apps > Facebook Login. Empty = no Facebook button.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
